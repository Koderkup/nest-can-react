{
  "name": "nest-can-react",
  "version": "0.3.0",
  "description": "Nest-native React Server Components over Flight — Nest owns the app, React streams the UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acefolioDev/nest-can-react.git"
  },
  "bugs": {
    "url": "https://github.com/acefolioDev/nest-can-react/issues"
  },
  "homepage": "https://github.com/acefolioDev/nest-can-react#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "bin": {
    "nest-can-react": "./bin/nest-can-react.mjs"
  },
  "files": [
    "dist",
    "src/build",
    "src/flight",
    "bin",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@fastify/static": "10.1.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-server-dom-rspack": "^0.1.0",
    "rxjs": "^7.8.1"
  },
  "peerDependenciesMeta": {
    "@nestjs/platform-fastify": {
      "optional": true
    },
    "@fastify/static": {
      "optional": true
    }
  },
  "dependencies": {
    "@rspack/core": "^2.2.6",
    "@rspack/dev-server": "^2.2.1",
    "@rspack/plugin-react-refresh": "^1.4.3",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "react-refresh": "^0.17.0",
    "react-server-dom-rspack": "^0.1.0",
    "rsc-html-stream": "0.0.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@types/express": "^5.0.0",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
