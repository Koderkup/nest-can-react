{
  "name": "nest-can-react",
  "version": "0.1.0",
  "description": "Add React pages and islands to an existing NestJS app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acefolioDev/nest-react.git"
  },
  "bugs": {
    "url": "https://github.com/acefolioDev/nest-react/issues"
  },
  "homepage": "https://github.com/acefolioDev/nest-react#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "bin": {
    "nest-can-react": "./bin/nest-can-react.mjs"
  },
  "files": [
    "dist",
    "src/build",
    "bin",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "sideEffects": [
    "./dist/assets/register-assets.js",
    "./dist/client/refresh-runtime.js",
    "./src/assets/register-assets.ts",
    "./src/client/refresh-runtime.ts"
  ],
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "express": "^5.1.0",
    "react-refresh": "^0.19.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
