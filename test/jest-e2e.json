{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "\\.(css|svg|png|jpe?g|webp)$": "<rootDir>/asset-stub.js",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
